{
  "extends": "./tsconfig.web.json",
  "include": [
    "src/web/**/*",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/main/env.d.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@main/*": [
        "src/main/*"
      ]
    }
  }
}
